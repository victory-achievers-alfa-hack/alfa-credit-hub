        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "Reason"
      },
      "RecommendationRequest": {
        "properties": {
          "companyId": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Companyid"
          },
          "purpose": {
            "type": "string",
            "enum": [
              "goods",
              "equipment",
              "cash_gap"
            ],
            "title": "Purpose"
          },
          "amount": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1000000000000.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,2}0*$"
              }
            ],
            "title": "Amount"
          },
          "termMonths": {
            "type": "integer",
            "maximum": 120.0,
            "minimum": 1.0,
            "title": "Termmonths"
          },
          "preference": {
            "type": "string",
            "enum": [
              "min_interest",
              "min_payment"
            ],
            "title": "Preference",
            "default": "min_interest"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "purpose",
          "amount",
          "termMonths"
        ],
        "title": "RecommendationRequest"
      },
